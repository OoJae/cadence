# The web app on an origin of its own (a VITE_API=runners build), so no runner
# serves the code that holds the payer's pocket key. Static files only: no proxy,
# no access log, no admin endpoint. Railway terminates TLS in front and sets $PORT.
{
	admin off
	persist_config off
}

:{$PORT:8080} {
	encode zstd gzip
	header {
		# The build's own policy (web/src/config/csp.ts), which it writes to csp.txt:
		# connect-src is 'self' plus exactly the runners it was built for.
		Content-Security-Policy "{file./srv/web/csp.txt}"
		Cross-Origin-Resource-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		-Server
	}
	@wasm path *.wasm
	header @wasm Content-Type application/wasm
	root * /srv/web
	# Vite names every file under /assets/ by its content, so one that exists can be cached
	# for good. Everything else (index.html under every app path, build.json, csp.txt,
	# /wasm/, a 404) is revalidated, so a redeploy reaches returning visitors at once. The ?
	# sets it only where the line above did not.
	@asset {
		path /assets/*
		file
	}
	header @asset Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control no-cache
	# A missing hashed asset (asked for by a page from an older deploy) is a 404, not
	# index.html served as a script. respond, not a file_server error, so the 404 carries
	# the headers above. Every other path falls back to index.html for the app's router.
	@missingAsset {
		path /assets/*
		not file
	}
	handle @missingAsset {
		respond 404
	}
	handle {
		try_files {path} /index.html
		file_server
	}
	log {
		output discard
	}
}
