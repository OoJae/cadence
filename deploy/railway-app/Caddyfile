# The web app on an origin of its own (a VITE_API=runners build), so no runner
# serves the code that holds the payer's pocket key. Static files only: no proxy,
# no access log, no admin endpoint. Railway terminates TLS in front and sets $PORT.
{
	admin off
	persist_config off
}

:{$PORT:8080} {
	encode zstd gzip
	header {
		# The build's own policy (web/src/config/csp.ts), which it writes to csp.txt:
		# connect-src is 'self' plus exactly the runners it was built for.
		Content-Security-Policy "{file./srv/web/csp.txt}"
		Cross-Origin-Resource-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		-Server
	}
	@wasm path *.wasm
	header @wasm Content-Type application/wasm
	root * /srv/web
	try_files {path} /index.html
	file_server
	log {
		output discard
	}
}
