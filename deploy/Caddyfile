# The web app and both runners behind one TLS front. PUBLIC_HOST and SANDBOX_HOST
# can be <ip>.sslip.io names, so no domain purchase is needed.
{$PUBLIC_HOST} {
	encode zstd gzip
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; media-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'; require-trusted-types-for 'script'; trusted-types cadence-worker; frame-ancestors 'none'"
		Cross-Origin-Resource-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		-Server
	}
	handle /api/* {
		reverse_proxy runner-main:8737
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
	log {
		output discard
	}
}

{$SANDBOX_HOST} {
	encode zstd gzip
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; media-src 'none'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'; require-trusted-types-for 'script'; trusted-types cadence-worker; frame-ancestors 'none'"
		Cross-Origin-Resource-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
		Referrer-Policy no-referrer
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		-Server
	}
	handle /api/* {
		reverse_proxy runner-sandbox:8738
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
	log {
		output discard
	}
}
