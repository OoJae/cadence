# Builds cadence-runner (and the CLI and decoder) for the server.
FROM rust:1.96-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --release -p cadence-runner -p cadence-cli -p cadence-decode

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
RUN useradd --system --create-home --home-dir /cadence cadence
COPY --from=build /src/target/release/cadence-runner /src/target/release/cadence /src/target/release/cadence-decode /usr/local/bin/
USER cadence
WORKDIR /cadence
# No telemetry, no analytics: the only egress is lightwalletd (local node or Tor) and drand.
ENTRYPOINT ["cadence-runner"]
