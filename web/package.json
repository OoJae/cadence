{
  "name": "cadence-web",
  "private": true,
  "version": "0.1.0",
  "description": "Cadence web front-end: payer subscribe flow, merchant dashboard, decoder and judge sandbox.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:wasm": "bash scripts/build-wasm.sh",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "node scripts/verify-and-screenshot.mjs",
    "verify:wasm": "node scripts/wasm-smoke.mjs",
    "verify:app-host": "node scripts/app-host-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "lenis": "1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fontkit": "2.0.4",
    "playwright": "1.60.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
